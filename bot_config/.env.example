# Environment Variables for Trading Bot
# NEVER commit this file to git! Add to .gitignore

# Exchange API Keys (Binance)
EXCHANGE_API_KEY=your_binance_api_key_here
EXCHANGE_SECRET=your_binance_secret_key_here

# Telegram Bot (Optional but recommended)
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# API Server (Optional - for web UI)
API_SERVER_USERNAME=admin
API_SERVER_PASSWORD=changeme_strong_password
JWT_SECRET_KEY=generate_random_secret_key_here
WS_TOKEN=generate_random_ws_token_here

# Trading Configuration
INITIAL_CAPITAL=1000
MAX_OPEN_TRADES=5
STAKE_AMOUNT=100
DRY_RUN=true

# Risk Management
STOP_LOSS_PERCENTAGE=2
TAKE_PROFIT_PERCENTAGE=3
MAX_DAILY_DRAWDOWN=10

# Database (Optional - for production)
DATABASE_URL=sqlite:///tradesv3.sqlite
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/freqtrade
